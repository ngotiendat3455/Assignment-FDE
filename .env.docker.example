# ==============================================================================
# Docker Compose Environment Template
# Copy to `.env.docker` (never commit `.env.docker` with real secrets):
#   Copy-Item .env.docker.example .env.docker
# ==============================================================================

# Choose 1 of 3 centralized profiles:
#   - OFFLINE_MOCK    (dev default: $0 Deterministic AI + x-simulator + Sandbox DM)
#   - HYBRID_AUTO     (staging: Live keys if configured, safe fallback otherwise)
#   - LIVE_PRODUCTION (prod: Strict Live Gemini/OpenAI + Live X API v2, zero silent fallback)
RUNTIME_PROFILE=OFFLINE_MOCK

# FastAPI Core & Persistence (mounted to named volume genai_sqlite_data:/app/data)
PORT=8000
HOST=0.0.0.0
DEBUG=False
DATABASE_URL=sqlite:////app/data/outreach.db
AUTO_SEED_LEDGER_BASELINE=False
SECRET_KEY=change-this-docker-secret-key-before-staging-or-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1

# Dispatch & Safety Controls
DISPATCH_MODE=SANDBOX
LIVE_X_DRY_RUN=False
ALLOWED_TEST_HANDLES=linhtran_robo,minh_quant,test_builder_sea

# LLM API Keys (required only in HYBRID_AUTO live or LIVE_PRODUCTION)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# X API v2 Configuration
# In OFFLINE_MOCK, backend routes lookup calls automatically to X_SIMULATOR_BASE_URL.
X_API_BASE_URL=https://api.twitter.com/2
X_SIMULATOR_BASE_URL=http://x-simulator:8099/2
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Frontend Next.js API Resolution ("auto" detects :3000 -> localhost:8000/api, or :80/ALB -> /api)
NEXT_PUBLIC_API_BASE_URL=auto
BACKEND_INTERNAL_URL=http://backend:8000/api

