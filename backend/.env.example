# Server Config
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & Authentication
SECRET_KEY=genai-fund-fde-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite file persistence - in-memory is strictly forbidden)
DATABASE_URL=sqlite:///./outreach.db

# Outreach Dispatch Mode (SANDBOX by default for 0-cost, safe, compliant evaluation)
# Options: SANDBOX | LIVE_X
DISPATCH_MODE=SANDBOX
# Set to True to validate LIVE_X whitelist & auth without calling the real DM endpoint
LIVE_X_DRY_RUN=False

# Comma-separated whitelist of handles permitted for real sending in LIVE_X mode
ALLOWED_TEST_HANDLES=linhtran_robo,minh_quant,test_builder_sea

# Optional LLM API Keys (If empty, system operates in mock/deterministic evaluation mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional X API v2 Credentials (Required only for LIVE_X mode)
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
