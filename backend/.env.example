# Server Config
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & Authentication
SECRET_KEY=genai-fund-fde-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite file persistence - in-memory is strictly forbidden)
DATABASE_URL=sqlite:///./outreach.db
AUTO_SEED_LEDGER_BASELINE=False

# Centralized Runtime Profile (Controls AI & X API v2 execution across /backend)
# - OFFLINE_MOCK    : Case 1 ($0 Deterministic AI Rubric + Local X Simulator + Sandbox DM, 0 external calls)
# - LIVE_PRODUCTION : Case 2 (Strict Live Gemini/OpenAI + Live X API v2, forbids silent fallback to mock/sim_dm)
# - HYBRID_AUTO     : Auto-detects configured keys per service while attaching execution_meta
RUNTIME_PROFILE=HYBRID_AUTO

# Outreach Dispatch Mode (SANDBOX by default for 0-cost, safe, compliant evaluation)
# Options: SANDBOX | LIVE_X
DISPATCH_MODE=SANDBOX
# Set to True to validate LIVE_X whitelist & auth without calling the real DM endpoint
LIVE_X_DRY_RUN=False

# Comma-separated whitelist of handles permitted for real sending in LIVE_X mode
ALLOWED_TEST_HANDLES=linhtran_robo,minh_quant,test_builder_sea

# Optional LLM API Keys (If empty, system operates in mock/deterministic evaluation mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional X API v2 Credentials & Base URL (Required only for live X lookup / LIVE_X dispatch)
# For $0 local HTTP testing without paid X credits, start `python -m backend.scripts.x_simulator`
# and set: X_API_BASE_URL=http://127.0.0.1:8099/2 and X_BEARER_TOKEN=sim_dev_bearer_token
X_API_BASE_URL=https://api.twitter.com/2
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
